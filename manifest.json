{
  "manifest_version": 3,
  "name": "Zentime - Web Timer & Screen Time",
  "version": "1.0.0",
  "description": "Clean, distraction-free per-website focus timer and daily screen time limiter for Google Chrome.",
  "permissions": [
    "tabs",
    "alarms",
    "notifications",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
