{
  "manifest_version": 3,
  "name": "Zentime - Web Timer & Screen Time",
  "version": "1.0.0",
  "description": "Clean, distraction-free per-website focus timer and daily screen time limiter for Google Chrome.",
  "permissions": [
    "tabs",
    "alarms",
    "notifications",
    "storage",
    "offscreen",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z"
      },
      "description": "Buka Popup Zentime / Open Zentime Focus Popup"
    },
    "quick_start_pomo": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Mulai Sesi Fokus 25m di situs aktif / Start 25m Focus Session"
    },
    "quick_block_break": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Jeda sejenak di tab saat ini / Mindful Pause on current tab"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
